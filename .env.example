# Copy to .env to override defaults (docker compose reads .env automatically).
# All values shown are the defaults used when .env is absent.

# --- Simulated clock -----------------------------------------------------------
SIM_DAY_SECONDS=300            # real seconds per simulated day (5 min)
READING_INTERVAL_SECONDS=5     # real seconds between readings per household (=> 24 simulated min)
SIM_START=2026-01-01T00:00:00+00:00   # must be midnight UTC
RANDOM_SEED=42
NUM_HOUSEHOLDS=12
NUM_ZONES=3

# --- Fault injection (exercise dedup + validation) --------------------------------
DUPLICATE_RATE=0.02
INVALID_RATE=0.01

# --- Speed layer (simulated minutes) ----------------------------------------------
WINDOW_MINUTES=120
WATERMARK_MINUTES=60

# --- Batch layer -------------------------------------------------------------------
BILLING_POLL_SECONDS=30
READINESS_TIMEOUT_SECONDS=180

# --- Alert thresholds ----------------------------------------------------------------
STALE_AFTER_SECONDS=30
INVALID_RATE_THRESHOLD=0.05
LOW_RENEWABLE_THRESHOLD=0.10
DASHBOARD_REFRESH_SECONDS=5

# --- Credentials (local demo only - change for anything shared) ----------------------
POSTGRES_DB=smartgrid
POSTGRES_USER=smartgrid
POSTGRES_PASSWORD=smartgrid
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_SECRET_KEY=local-demo-secret-change-me

# --- Host ports ----------------------------------------------------------------------
DASHBOARD_HOST_PORT=8501
API_HOST_PORT=8000
AIRFLOW_HOST_PORT=8080
POSTGRES_HOST_PORT=5433
KAFKA_HOST_PORT=29092
SPARK_DRIVER_MEMORY=1g
